# Copy to .env for local overrides. Every value here has a development default.
BACKDATE_ENV=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
PGHOST=localhost
PGPORT=5433
PGDATABASE=backdate
PGUSER=
PGPASSWORD=
BACKDATE_LEASE_SECONDS=30
BACKDATE_MAX_ATTEMPTS=5
BACKDATE_MAX_STALE_BACKLOG=50000
LOG_LEVEL=INFO
LOG_JSON=false
